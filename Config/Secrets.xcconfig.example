// Copy to Config/Secrets.xcconfig (git-ignored). Values here override Base.xcconfig.

// --- Signing (required to run on a device) ---------------------------------
// Your Apple Developer Team ID: Xcode → Settings → Accounts → select your
// Apple ID → the 10-character ID next to your name. With this set, Xcode's
// Signing & Capabilities tab shows the team already selected and does not
// modify project.pbxproj.
DEVELOPMENT_TEAM = ABCDE12345

// Must be unique to you; Apple rejects com.example.*.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.Aurelia

// --- Optional nutrition proxy -----------------------------------------------
NUTRITION_PROXY_URL = https://YOUR_PROJECT.supabase.co/functions/v1/nutrition-proxy
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_ANON_KEY
