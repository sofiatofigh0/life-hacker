// Base build configuration, attached to every target and configuration.
//
// Personal signing values live in Secrets.xcconfig, which is git-ignored and
// pulled in by the `#include?` at the bottom — so `git pull` never conflicts
// with the Team and bundle identifier Xcode would otherwise write into
// project.pbxproj. Copy Secrets.xcconfig.example to Secrets.xcconfig once.

// Defaults. Override in Secrets.xcconfig.
PRODUCT_BUNDLE_IDENTIFIER = com.example.Aurelia
DEVELOPMENT_TEAM =

// Optional nutrition proxy. With no URL, online food search reports itself
// unavailable while manual foods, saved foods, and barcode lookup keep working.
NUTRITION_PROXY_URL =
SUPABASE_ANON_KEY =

#include? "Secrets.xcconfig"
