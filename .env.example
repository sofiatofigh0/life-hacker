# Copy values into a local, untracked Config/Secrets.xcconfig.
NUTRITION_PROXY_URL = https://YOUR_PROJECT.supabase.co/functions/v1/nutrition-proxy
SUPABASE_ANON_KEY = YOUR_PUBLISHABLE_ANON_KEY

# Set only as a Supabase Edge Function secret, never in the iOS app:
USDA_API_KEY = YOUR_USDA_FOODDATA_CENTRAL_KEY
